# Gemini API Key for RAG, Forecasting & Reviewing Attribution
GEMINI_API_KEY=your_gemini_api_key_here

# FRED (Federal Reserve Economic Data) API Key for Macro Economic Data
# Get free key from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# SEC User Agent (Required by SEC EDGAR: Format - Sample Company Name AdminContact@<sample company domain>.com)
SEC_USER_AGENT=InvestmentResearchAgent admin@invest.com
